{
  "manifest_version": 3,
  "name": "QuickApply – Job Auto-Fill",
  "version": "3.7.0",
  "description": "Auto-fill job application forms for multiple clients with one click. Manage profiles, upload CVs, and apply faster.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "webNavigation",
    "contextMenus",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "fill-active-client": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Fill the active client's profile on this page"
    },
    "toggle-mini-card": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "Toggle the floating Job-Analyzer mini-card"
    },
    "refresh-jd": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Re-extract this JD and refresh the mini-card"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "storage.js",
        "cache.js",
        "jd-cache.js",
        "trusted-input.js",
        "field-mapper.js",
        "learning-engine.js",
        "field-discoverer.js",
        "fill-engine.js",
        "ai-engine.js",
        "ai-resolver.js",
        "platforms/base-filler.js",
        "platforms/generic.js",
        "platforms/_jd-helpers.js",
        "platforms/workday.js",
        "platforms/workday-jd.js",
        "platforms/greenhouse.js",
        "platforms/greenhouse-jd.js",
        "platforms/icims.js",
        "platforms/icims-jd.js",
        "platforms/smartrecruiters.js",
        "platforms/smartrecruiters-jd.js",
        "platforms/lever.js",
        "platforms/lever-jd.js",
        "platforms/ashby.js",
        "platforms/ashby-jd.js",
        "platforms/workable.js",
        "platforms/workable-jd.js",
        "platforms/rippling.js",
        "platforms/rippling-jd.js",
        "platforms/breezy.js",
        "platforms/breezy-jd.js",
        "platforms/netflix.js",
        "platforms/netflix-jd.js",
        "platforms/tiktok.js",
        "platforms/tiktok-jd.js",
        "platforms/gem.js",
        "platforms/gem-jd.js",
        "platforms/successfactors.js",
        "platforms/successfactors-jd.js",
        "platforms/ultipro.js",
        "platforms/ultipro-jd.js",
        "platforms/dayforce.js",
        "platforms/dayforce-jd.js",
        "platforms/eightfold.js",
        "platforms/eightfold-jd.js",
        "platforms/teamtailor.js",
        "platforms/teamtailor-jd.js",
        "jd-extractor.js",
        "fit-matcher.js",
        "mini-card-dismissals.js",
        "submit-engine.js",
        "content.js",
        "mini-card.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/pdf.worker.min.js",
        "platform-seeds.json",
        "mini-card-dismissals.js",
        "jd-queue.js",
        "jd-batch-runner.js",
        "test/test-job-analyzer.html",
        "test/test-fit-card-compact.html",
        "test/test-minicard-dismissals.html",
        "test/test-jd-queue.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
